# Copy to services/frp/.env (gitignored) and set the real values.
# docker compose passes these to the frp service; frps.ini reads them as
# {{ .Envs.NAME }}. Set all three: a missing variable is rendered as the
# literal text "<no value>".
# Use plain [A-Za-z0-9] values (e.g. `openssl rand -hex 24`): compose expands
# `$` in env files, and quotes, spaces, `#` or `;` can be altered on the way.
FRP_TOKEN=change-me-frp-token
FRP_DASHBOARD_USER=change-me-dashboard-user
FRP_DASHBOARD_PWD=change-me-dashboard-password
