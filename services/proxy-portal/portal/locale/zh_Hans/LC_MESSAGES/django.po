msgid "%(n)d s ago"
msgstr "%(n)d 秒前"

#, python-format
msgid "%(n)d min ago"
msgstr "%(n)d 分钟前"

#, python-format
msgid "%(n)d h ago"
msgstr "%(n)d 小时前"

#, python-format
msgid "%(n)d days ago"
msgstr "%(n)d 天前"

msgctxt "service account"
msgid "Auto-switching proxies"
msgstr "两个自动切换代理"

msgctxt "service account"
msgid "Monitoring"
msgstr "监控"

msgid "The page expired"
msgstr "页面已过期"

msgid "Reload the page and try again."
msgstr "请刷新页面后重试。"

msgid "Page not found"
msgstr "页面不存在"

msgid "There is no page at this address."
msgstr "此地址没有页面。"

msgid "Degraded"
msgstr "部分异常"

msgid "no probe results"
msgstr "没有探测结果"

#, python-format
msgid "success %(rate)s, probed %(coverage)s of the time"
msgstr "成功率 %(rate)s，探测覆盖 %(coverage)s 的时间"

msgid "The reset could not be started. Nothing changed."
msgstr "无法开始重置，没有任何变更。"

msgid "The reset's state could not be read. Reload the page to see it."
msgstr "无法读取重置的状态，请刷新页面查看。"

msgid "The portal could not be reached. Try again."
msgstr "无法连接门户，请重试。"

msgid "Getting the password…"
msgstr "正在获取密码…"

msgid "You are signed out. Sign in again to continue."
msgstr "你已退出登录，请重新登录后继续。"

msgid "Enter your Determined username and password."
msgstr "请输入 Determined 用户名和密码。"

#, python-format
msgid "Too many failed sign-ins. Try again in %(n)d minute."
msgid_plural "Too many failed sign-ins. Try again in %(n)d minutes."
msgstr[0] "登录失败次数过多，请 %(n)d 分钟后再试。"

msgid ""
"The Determined master cannot check your sign-in right now. Try again later."
msgstr "Determined master 暂时无法校验登录，请稍后再试。"

msgid "This Determined account is deactivated."
msgstr "这个 Determined 账号已停用。"

msgid "Wrong username or password."
msgstr "用户名或密码错误。"
