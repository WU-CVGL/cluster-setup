              "id": "byName",
              "options": "xid"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "peak per 5 min"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
