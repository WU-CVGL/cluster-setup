    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "One row per GPU and XID code. 'peak per 5 min' = the most XID events of that code in one 5-minute window during the selected time range (DCGM_EXP_XID_ERRORS_COUNT). 'since exporter start' = all events of that code counted since DCGM-Exporter last started (DCGM_EXP_XID_ERRORS_TOTAL). 'last XID message' = the meaning of the most recent XID code on that GPU since the exporter started (DCGM_FI_DEV_XID_ERRORS, kept until another code arrives or the exporter restarts). Codes 13, 31, 43 and 45 are usually caused by the application; every other code is treated as hardware or driver. Catalog: https://docs.nvidia.com/deploy/xid-errors/",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          },
