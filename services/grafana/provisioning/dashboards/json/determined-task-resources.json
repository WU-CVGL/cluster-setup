      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "description": "DCGM reports MiB; values are converted to bytes for display. Full-device framebuffer use; it is not per-process memory.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
