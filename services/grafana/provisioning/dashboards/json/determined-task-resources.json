      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(((DCGM_FI_DEV_POWER_USAGE{job=\"dcgm\",det_cluster=~\"${cluster:regex}\",gpu_uuid!=\"\"} >= 0) and on (det_cluster,gpu_uuid) (DCGM_FI_DEV_POWER_USAGE{job=\"dcgm\",det_cluster=~\"${cluster:regex}\",gpu_uuid!=\"\"} <= 10000)) and on (det_cluster,gpu_uuid) (count by (det_cluster,gpu_uuid) (DCGM_FI_DEV_POWER_USAGE{job=\"dcgm\",det_cluster=~\"${cluster:regex}\",gpu_uuid!=\"\"}) == 1)) * on (det_cluster,gpu_uuid) group_left (task_id,allocation_id) det:gpu_task:info{det_cluster=~\"${cluster:regex}\",task_id=~\"${task_id:regex}\",allocation_id=~\"${allocation_id:regex}\"}",
