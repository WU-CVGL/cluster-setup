# Copy to services/grafana/.env (gitignored) and set the real value.
# Loaded by both the grafana and grafana-renderer services. Both variables must
# hold the SAME token: Grafana sends it, the image renderer checks it. Grafana
# refuses to start with the default renderer token.
# Use a plain [A-Za-z0-9] value (e.g. `openssl rand -hex 24`): compose expands
# `$` in env files, and quotes, spaces or `#` can be altered on the way.
GF_RENDERING_RENDERER_TOKEN=change-me-renderer-token
AUTH_TOKEN=change-me-renderer-token
