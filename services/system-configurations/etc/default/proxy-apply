# Settings of proxy-apply.service (services/proxy-portal/applier/README.md). Install as /etc/default/proxy-apply.
# The services folder of this repository's checkout on the VM.
PROXY_APPLY_SERVICES_DIR=/home/<admin>/ws/cluster-setup/services
# The user that writes the requests: the portal's uid.
PROXY_APPLY_REQUESTER=proxy-portal
PROXY_APPLY_SPOOL=/var/lib/proxy-portal/spool
# The HTTP ports of the HA entries ha-general and ha-private on this host, and the URL fetched through them
# to verify a change.
PROXY_APPLY_HA_HTTP=127.0.0.1:30889
PROXY_APPLY_HA_PRIVATE_HTTP=127.0.0.1:31889
PROXY_APPLY_PROBE_URL=https://www.google.com/generate_204
PROXY_APPLY_VERIFY_TIMEOUT=60
# Optional: PROXY_APPLY_COMPOSE_FILE (default <services>/docker-compose.yml), PROXY_APPLY_COMPOSE_PROJECT.
