# Applies the proxy portal's account change requests (services/proxy-portal/applier/README.md).
# Started by proxy-apply.path when a request arrives, and by proxy-apply.timer to expire one-time results.
[Unit]
Description=Apply proxy account change requests
After=docker.service
Requires=docker.service
# Requests can come in bursts, and each run can end in a second: no start limit, or the path unit stops
StartLimitIntervalSec=0

[Service]
Type=oneshot
EnvironmentFile=/etc/default/proxy-apply
ExecStart=/usr/bin/python3 -I -B ${PROXY_APPLY_SERVICES_DIR}/proxy-portal/applier/proxy_apply.py run
UMask=0077
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
